<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">

        <LinearLayout android:id="@+id/top" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="#FFFFFF">
            <FrameLayout android:id="@+id/topbar" android:layout_width="match_parent" android:layout_height="52dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp">
                    <ImageButton android:id="@+id/btnMenu" android:layout_width="44dp" android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_menu"
                        android:contentDescription="選單" android:padding="10dp" android:scaleType="centerInside"/>
                    <ImageButton android:id="@+id/btnFlash" android:layout_width="44dp" android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_flash_off"
                        android:contentDescription="閃光燈" android:padding="10dp" android:scaleType="centerInside"/>
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                    <ImageButton android:id="@+id/btnLens" android:layout_width="44dp" android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_flip"
                        android:contentDescription="切換前後鏡頭" android:padding="10dp" android:scaleType="centerInside"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/btnWmEntry" android:layout_width="wrap_content" android:layout_height="34dp"
                    android:layout_gravity="center" android:background="@drawable/pill_outline"
                    android:gravity="center" android:paddingStart="10dp" android:paddingEnd="14dp"
                    android:clickable="true" android:focusable="true" android:contentDescription="浮水印設定">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_shield" android:importantForAccessibility="no"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="浮水印" android:textColor="#111111" android:textStyle="bold" android:textSize="13sp" android:layout_marginStart="5dp"/>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <FrameLayout android:id="@+id/stage" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:background="#1C1C1C">
            <androidx.camera.view.PreviewView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="match_parent"/>
            <tw.timecam.WatermarkView android:id="@+id/wm" android:layout_width="match_parent" android:layout_height="match_parent"/>
            <View android:id="@+id/focus" android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/focus_ring" android:alpha="0"/>
            <View android:id="@+id/flashFx" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFF" android:alpha="0"/>
            <LinearLayout android:id="@+id/rec" android:layout_width="wrap_content" android:layout_height="28dp"
                android:layout_gravity="top|center_horizontal" android:layout_marginTop="14dp"
                android:background="@drawable/rec_badge" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp"
                android:visibility="gone">
                <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/rec_dot"/>
                <TextView android:id="@+id/recTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="7dp" android:text="00:00" android:textColor="#FFF" android:textStyle="bold" android:textSize="13sp" android:fontFeatureSettings="tnum"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/evRow" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start" android:layout_marginStart="10dp"
                android:orientation="vertical" android:gravity="center_horizontal" android:visibility="gone"
                android:background="@drawable/rec_badge" android:padding="8dp">
                <TextView android:id="@+id/evLbl" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="EV 0" android:textColor="#FFF" android:textStyle="bold" android:textSize="11sp"/>
                <SeekBar android:id="@+id/ev" android:layout_width="120dp" android:layout_height="wrap_content"
                    android:progressTint="#FFFFFF" android:thumbTint="#FFFFFF" android:progressBackgroundTint="#66FFFFFF"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/zoomStack" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical" android:layout_marginEnd="10dp" android:orientation="vertical" android:gravity="center_horizontal"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="end|bottom" android:layout_marginEnd="12dp" android:layout_marginBottom="16dp"
                android:orientation="vertical">
                <ImageButton android:id="@+id/btnEdit" android:layout_width="44dp" android:layout_height="44dp"
                    android:background="@drawable/float_circle" android:src="@drawable/ic_pencil" android:contentDescription="編輯浮水印" android:padding="11dp" android:scaleType="centerInside"/>
                <ImageButton android:id="@+id/btnPin" android:layout_width="44dp" android:layout_height="44dp"
                    android:layout_marginTop="12dp" android:background="@drawable/float_circle" android:src="@drawable/ic_pin"
                    android:contentDescription="定位" android:padding="11dp" android:scaleType="centerInside"/>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout android:id="@+id/ctrl" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="#FFFFFF" android:paddingTop="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="96dp"
                android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="18dp">
                <LinearLayout android:id="@+id/pick" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="start|center_vertical"
                    android:clickable="true" android:focusable="true" android:contentDescription="本機照片">
                    <ImageView android:id="@+id/lastThumb" android:layout_width="48dp" android:layout_height="48dp"
                        android:background="@drawable/thumb_frame" android:scaleType="centerCrop" android:contentDescription="最近一張"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:text="本機照片" android:textColor="#444444" android:textSize="11sp" android:textStyle="bold"/>
                </LinearLayout>
                <tw.timecam.ShutterView android:id="@+id/shutter" android:layout_width="78dp" android:layout_height="78dp" android:contentDescription="拍攝"/>
                <LinearLayout android:id="@+id/settings" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="end|center_vertical"
                    android:clickable="true" android:focusable="true" android:contentDescription="浮水印範本">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_tpl"
                        android:scaleType="centerInside" android:padding="7dp" android:importantForAccessibility="no"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:text="範本" android:textColor="#444444" android:textSize="11sp" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" android:paddingBottom="6dp">
                <TextView android:id="@+id/mPhoto" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="6dp" android:paddingBottom="10dp"
                    android:text="照片" android:textStyle="bold" android:textSize="15sp" android:letterSpacing="0.06" android:textColor="#111111"/>
                <TextView android:id="@+id/mVideo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="6dp" android:paddingBottom="10dp"
                    android:text="影片" android:textStyle="bold" android:textSize="15sp" android:letterSpacing="0.06" android:textColor="#9A9A9A"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View android:id="@+id/scrim" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#73000000" android:visibility="gone" android:clickable="true" android:focusable="true"/>
    <LinearLayout android:id="@+id/drawer" android:layout_width="280dp" android:layout_height="match_parent"
        android:orientation="vertical" android:background="#FFFFFF" android:visibility="gone" android:clickable="true"
        android:paddingTop="24dp" android:paddingBottom="16dp" android:elevation="8dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="時間相機" android:textStyle="bold" android:textSize="20sp" android:textColor="#111"
            android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingBottom="8dp"/>
        <TextView android:id="@+id/dSettings" android:layout_width="match_parent" android:layout_height="48dp"
            android:gravity="center_vertical" android:paddingStart="22dp" android:text="設定" android:textSize="15sp" android:textStyle="bold" android:textColor="#111"
            android:background="?attr/selectableItemBackground"/>
        <TextView android:id="@+id/dTorch" android:layout_width="match_parent" android:layout_height="48dp"
            android:gravity="center_vertical" android:paddingStart="22dp" android:paddingEnd="22dp" android:text="手電筒　關" android:textSize="15sp" android:textStyle="bold" android:textColor="#111"
            android:background="?attr/selectableItemBackground"/>
        <TextView android:id="@+id/dExt" android:layout_width="match_parent" android:layout_height="48dp"
            android:gravity="center_vertical" android:paddingStart="22dp" android:paddingEnd="22dp" android:text="影像模式　標準" android:textSize="15sp" android:textStyle="bold" android:textColor="#111"
            android:background="?attr/selectableItemBackground"/>
        <TextView android:id="@+id/dStamp" android:layout_width="match_parent" android:layout_height="48dp"
            android:gravity="center_vertical" android:paddingStart="22dp" android:text="幫已有照片加浮水印" android:textSize="15sp" android:textStyle="bold" android:textColor="#111"
            android:background="?attr/selectableItemBackground"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:paddingStart="22dp" android:paddingEnd="22dp" android:text="手電筒與影像模式會套用在拍照上。舊照片加浮水印仍可從這裡選。"
            android:textSize="11sp" android:textColor="#999999"/>
    </LinearLayout>
</FrameLayout>
