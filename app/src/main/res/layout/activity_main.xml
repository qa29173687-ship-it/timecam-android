<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFFFF">
    <androidx.camera.view.PreviewView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="match_parent"/>
    <tw.timecam.WatermarkView android:id="@+id/wm" android:layout_width="match_parent" android:layout_height="match_parent"/>
    <View android:id="@+id/focus" android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/focus_ring" android:alpha="0"/>
    <View android:id="@+id/flashFx" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFF" android:alpha="0"/>
    <LinearLayout android:id="@+id/top" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/siteChip" style="@style/Chip" android:layout_marginStart="0dp" android:drawablePadding="6dp"/>
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
            <TextView android:id="@+id/rec" android:layout_width="wrap_content" android:layout_height="32dp" android:background="@drawable/rec_bg"
                android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="#FFF" android:textStyle="bold"
                android:textSize="15sp" android:fontFeatureSettings="tnum" android:text="● 00:00" android:visibility="gone"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:layout_marginTop="10dp">
            <TextView android:id="@+id/btnFlash" style="@style/Chip" android:text="⚡ 自動"/>
            <TextView android:id="@+id/btnTorch" style="@style/Chip" android:text="🔦 關"/>
            <TextView android:id="@+id/btnExt" style="@style/Chip" android:text="標準"/>
            <TextView android:id="@+id/btnLens" style="@style/Chip" android:text="⇄ 鏡頭"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/ctrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:orientation="vertical" android:paddingTop="10dp" android:paddingBottom="18dp" android:background="@drawable/ctrl_grad">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="20dp">
            <TextView android:id="@+id/zoomLbl" android:layout_width="52dp" android:layout_height="wrap_content" android:textColor="#C77800" android:textStyle="bold" android:text="1.0x"/>
            <SeekBar android:progressTint="#FFB020" android:thumbTint="#FFB020" android:progressBackgroundTint="#555555" android:id="@+id/zoom" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:max="100"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/evRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="20dp">
            <TextView android:id="@+id/evLbl" android:layout_width="52dp" android:layout_height="wrap_content" android:textColor="#1A1A1A" android:textStyle="bold" android:text="EV 0"/>
            <SeekBar android:progressTint="#FFB020" android:thumbTint="#FFB020" android:progressBackgroundTint="#555555" android:id="@+id/ev" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/lastBar" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_gravity="center_horizontal"
            android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/glass_pill" android:paddingStart="12dp" android:paddingEnd="4dp"
            android:layout_marginBottom="8dp" android:visibility="gone">
            <TextView android:id="@+id/lastName" android:layout_width="wrap_content" android:maxWidth="150dp" android:layout_height="wrap_content" android:textColor="#FFF" android:textSize="12sp" android:singleLine="true" android:ellipsize="middle"/>
            <TextView android:id="@+id/btnUpload" android:layout_width="wrap_content" android:layout_height="32dp" android:gravity="center" android:background="@drawable/done_btn"
                android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginStart="8dp" android:text="☁ 上傳" android:textColor="#111" android:textStyle="bold"/>
            <TextView android:id="@+id/btnMulti" android:layout_width="wrap_content" android:layout_height="32dp" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="6dp" android:text="多選" android:textColor="#FFB020" android:textStyle="bold"/>
            <TextView android:id="@+id/btnClose" android:layout_width="32dp" android:layout_height="32dp" android:gravity="center" android:text="✕" android:textColor="#B3FFFFFF"/>
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
            android:background="@drawable/glass_pill" android:padding="3dp" android:layout_marginTop="6dp" android:layout_marginBottom="14dp">
            <TextView android:id="@+id/mPhoto" android:layout_width="wrap_content" android:layout_height="30dp" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="照片" android:textStyle="bold" android:letterSpacing="0.1"/>
            <TextView android:id="@+id/mVideo" android:layout_width="wrap_content" android:layout_height="30dp" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="錄影" android:textStyle="bold" android:letterSpacing="0.1"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
            <ImageButton android:id="@+id/pick" android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/glass_circle" android:src="@drawable/ic_gallery" android:contentDescription="選相片"/>
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
            <tw.timecam.ShutterView android:id="@+id/shutter" android:layout_width="80dp" android:layout_height="80dp" android:contentDescription="拍攝"/>
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
            <ImageButton android:id="@+id/settings" android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/glass_circle" android:src="@drawable/ic_sliders" android:contentDescription="浮水印資訊"/>
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
