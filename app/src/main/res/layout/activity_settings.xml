<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F4F4F5">
    <LinearLayout android:id="@+id/settingsTop" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="#F4F4F5">
        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical">
            <ImageButton android:id="@+id/btnBack" android:layout_width="44dp" android:layout_height="44dp"
                android:layout_marginStart="4dp" android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back" android:contentDescription="返回" android:padding="10dp"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:gravity="center" android:text="設定" android:textStyle="bold" android:textSize="17sp" android:textColor="#111"/>
            <View android:layout_width="44dp" android:layout_height="44dp" android:layout_marginEnd="4dp"/>
        </LinearLayout>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/settingsBody" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp" android:paddingBottom="32dp">
            <LinearLayout style="@style/SettingsCard">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="快門聲音" android:textStyle="bold" android:textSize="15sp" android:textColor="#111"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="拍照時發出快門聲；手機在靜音或震動模式時不會出聲" android:textSize="12sp" android:textColor="#8B8B8B" android:layout_marginTop="2dp"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat android:id="@+id/swShutterSound" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/rowPhotoRes" style="@style/SettingsCard" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="照片畫素" android:textStyle="bold" android:textSize="15sp" android:textColor="#111"/>
                        <TextView android:id="@+id/photoResValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="約 12MP" android:textSize="13sp" android:textColor="#111" android:textStyle="bold" android:layout_marginTop="2dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="依這支手機相機支援的尺寸；越高畫素，拍完處理可能較久" android:textSize="12sp" android:textColor="#8B8B8B" android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="相機會把原檔上傳到你指定的一個雲端硬碟資料夾，不會在 App 裡分類。開啟後仍會先存進手機相簿。"
                android:textSize="12sp" android:textColor="#888888" android:lineSpacingMultiplier="1.4" android:padding="4dp" android:paddingBottom="12dp"/>

            <LinearLayout style="@style/SettingsCard">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="自動上傳 Google 雲端" android:textStyle="bold" android:textSize="15sp" android:textColor="#111"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="拍完或每天固定時間，存到雲端硬碟" android:textSize="12sp" android:textColor="#8B8B8B" android:layout_marginTop="2dp"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat android:id="@+id/swUpload" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/uploadOpts" style="@style/SettingsCard">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="上傳時機" android:textStyle="bold" android:textSize="15sp" android:textColor="#111" android:paddingStart="16dp" android:paddingTop="12dp"/>
                <RadioGroup android:id="@+id/whenGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="12dp" android:paddingEnd="16dp" android:paddingBottom="4dp">
                    <RadioButton android:id="@+id/whenImmediate" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="拍完馬上" android:textSize="15sp" android:textColor="#111"/>
                    <RadioButton android:id="@+id/whenDaily" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="每天指定時間" android:textSize="15sp" android:textColor="#111"/>
                </RadioGroup>
                <LinearLayout android:id="@+id/timeRow" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:paddingStart="28dp" android:paddingEnd="16dp" android:paddingBottom="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="每天在" android:textSize="14sp" android:textColor="#444" android:textStyle="bold"/>
                    <TextView android:id="@+id/btnTime" android:layout_width="wrap_content" android:layout_height="36dp"
                        android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:gravity="center"
                        android:background="@drawable/field_light" android:paddingStart="14dp" android:paddingEnd="14dp"
                        android:text="23:00" android:textStyle="bold" android:textSize="16sp" android:textColor="#111" android:fontFeatureSettings="tnum"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="自動上傳" android:textSize="14sp" android:textColor="#444" android:textStyle="bold"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EBEBEB"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="只在 Wi‑Fi 上傳" android:textStyle="bold" android:textSize="15sp" android:textColor="#111"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="用行動網路時先留在手機" android:textSize="12sp" android:textColor="#8B8B8B"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat android:id="@+id/swWifi" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EBEBEB"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="16dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="只在充電時上傳" android:textStyle="bold" android:textSize="15sp" android:textColor="#111"/>
                    <androidx.appcompat.widget.SwitchCompat android:id="@+id/swCharge" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EBEBEB"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="雲端資料夾名稱" android:textStyle="bold" android:textSize="15sp" android:textColor="#111"/>
                    <EditText android:id="@+id/fFolder" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:background="@drawable/field_light" android:padding="10dp"
                        android:text="時間相機" android:maxLines="1" android:inputType="text" android:textSize="15sp" android:textColor="#111"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/SettingsCard" android:orientation="vertical" android:padding="16dp">
                <TextView android:id="@+id/acctLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="尚未連結 Google 帳號" android:textStyle="bold" android:textSize="15sp" android:textColor="#111"/>
                <TextView android:id="@+id/acctSub" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:text="連結後才會上傳到雲端硬碟" android:textSize="12sp" android:textColor="#8B8B8B"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                    <TextView android:id="@+id/btnConnect" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                        android:gravity="center" android:background="@drawable/done_dark" android:text="連結 Google 帳號"
                        android:textColor="#FFF" android:textStyle="bold" android:textSize="14sp"/>
                    <TextView android:id="@+id/btnDisconnect" android:layout_width="wrap_content" android:layout_height="44dp"
                        android:layout_marginStart="8dp" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp"
                        android:text="中斷" android:textColor="#C0392B" android:textStyle="bold" android:textSize="14sp" android:visibility="gone"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/SettingsCard" android:orientation="vertical" android:padding="16dp">
                <TextView android:id="@+id/stPending" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="待上傳 0 張" android:textStyle="bold" android:textSize="15sp" android:textColor="#111"/>
                <TextView android:id="@+id/stLast" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="尚未上傳" android:textSize="13sp" android:textColor="#8B8B8B"/>
                <TextView android:id="@+id/stError" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="" android:textSize="13sp" android:textColor="#C0392B" android:visibility="gone"/>
                <TextView android:id="@+id/btnUploadNow" android:layout_width="match_parent" android:layout_height="44dp"
                    android:layout_marginTop="12dp" android:gravity="center" android:background="@drawable/done_dark"
                    android:text="立即上傳" android:textColor="#FFF" android:textStyle="bold" android:textSize="14sp"/>
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:paddingTop="12dp" android:text="時間相機 1.3.1" android:textSize="11sp" android:textColor="#AAAAAA"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
