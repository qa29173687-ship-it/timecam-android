<resources>
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="colorPrimary">#111111</item>
        <item name="colorAccent">#34C759</item>
        <item name="android:timePickerDialogTheme">@style/TimePickerTheme</item>
    </style>
    <style name="SettingsTheme" parent="AppTheme">
        <item name="android:windowBackground">#F4F4F5</item>
    </style>
    <style name="TimePickerTheme" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorPrimary">#111111</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>
    <style name="SheetTheme" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/SheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/white</item>
    </style>
    <style name="SheetStyle" parent="Widget.Material3.BottomSheet"><item name="backgroundTint">@android:color/transparent</item></style>
    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/field_light</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">#111111</item>
        <item name="android:textColorHint">#66888888</item>
        <item name="android:textSize">16sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>
    <style name="FieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#8B8B8B</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginBottom">5dp</item>
    </style>
    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:background">@drawable/glass_pill</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginStart">6dp</item>
    </style>
    <style name="SettingsCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/settings_card</item>
        <item name="android:layout_marginBottom">14dp</item>
    </style>
</resources>
